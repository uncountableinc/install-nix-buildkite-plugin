#!/bin/bash

set -euo pipefail

PLUGIN_PREFIX="BUILDKITE_PLUGIN_INSTALL_NIX"

collect_plugin_list() {
  local key="$1"
  local index=0
  local var
  while true; do
    var="${PLUGIN_PREFIX}_${key}_${index}"
    if [ -z "${!var:-}" ]; then
      break
    fi
    printf '%s\n' "${!var}"
    index=$((index + 1))
  done
}

join_by_space() {
  local joined=""
  local value
  while IFS= read -r value; do
    if [ -z "$joined" ]; then
      joined="$value"
    else
      joined="$joined $value"
    fi
  done
  printf '%s' "$joined"
}

extra_conf_args=()

substituters="$(collect_plugin_list EXTRA_SUBSTITUTERS | join_by_space)"
if [ -n "$substituters" ]; then
  extra_conf_args+=(--extra-conf "extra-substituters = $substituters")
fi

trusted_keys="$(collect_plugin_list EXTRA_TRUSTED_PUBLIC_KEYS | join_by_space)"
if [ -n "$trusted_keys" ]; then
  extra_conf_args+=(--extra-conf "extra-trusted-public-keys = $trusted_keys")
fi

while IFS= read -r conf_line; do
  [ -n "$conf_line" ] && extra_conf_args+=(--extra-conf "$conf_line")
done < <(collect_plugin_list EXTRA_CONF)

echo "Installing Determinate Nix for $OSTYPE"
if [ -n "${extra_conf_args[*]+set}" ]; then
  printf 'Applying nix.conf lines:\n'
  printf '  %s\n' "${extra_conf_args[@]}" | grep -v -- '--extra-conf' || true
fi

case "$OSTYPE" in
  linux*)
    planner_args=(install linux --no-confirm --init none)
    daemon_is_managed=false
    ;;
  darwin*)
    planner_args=(install --no-confirm)
    daemon_is_managed=true
    ;;
  *)
    echo "install-nix: unsupported OSTYPE '$OSTYPE'" >&2
    exit 1
    ;;
esac

curl --proto '=https' --tlsv1.2 -sSf -L "https://install.determinate.systems/nix?ci=buildkite" | \
    sh -s -- "${planner_args[@]}" \
      ${extra_conf_args[@]+"${extra_conf_args[@]}"}

export PATH="/nix/var/nix/profiles/default/bin:$HOME/.nix-profile/bin:$PATH"

package_index=0
while true; do
  package_source_var="${PLUGIN_PREFIX}_PACKAGES_${package_index}_SOURCE"
  package_source="${!package_source_var:-}"
  if [ -z "$package_source" ]; then
    break
  fi
  attrs=()
  while IFS= read -r attr; do
    attrs+=("$attr")
  done < <(collect_plugin_list "PACKAGES_${package_index}_ATTRS")
  if [ "${#attrs[@]}" -gt 0 ]; then
    echo "Installing ${attrs[*]} from $package_source"
    nix-env --install --attr "${attrs[@]}" --file "$package_source"
  fi
  package_index=$((package_index + 1))
done

if [ "${BUILDKITE_PLUGIN_INSTALL_NIX_START_DAEMON:-false}" = "true" ] && [ "$daemon_is_managed" = "true" ]; then
  echo "install-nix: start-daemon is ignored on $OSTYPE; the init system owns the daemon"
elif [ "${BUILDKITE_PLUGIN_INSTALL_NIX_START_DAEMON:-false}" = "true" ]; then
  nohup /usr/local/bin/determinate-nixd daemon > /dev/null 2>&1 &
  export NIX_REMOTE=daemon

  echo "Wait for Determinate Nixd status"
  while ! determinate-nixd status >/dev/null; do
      sleep 0.1
  done
  echo "The Nix daemon is ready!"
fi
