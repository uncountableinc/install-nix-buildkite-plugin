#!/bin/bash

set -euo pipefail

PLUGIN_PREFIX="BUILDKITE_PLUGIN_INSTALL_NIX"

collect_plugin_list() {
  local key="$1"
  local index=0
  local var
  while true; do
    var="${PLUGIN_PREFIX}_${key}_${index}"
    if [ -z "${!var:-}" ]; then
      break
    fi
    printf '%s\n' "${!var}"
    index=$((index + 1))
  done
}

join_by_space() {
  local joined=""
  local value
  while IFS= read -r value; do
    if [ -z "$joined" ]; then
      joined="$value"
    else
      joined="$joined $value"
    fi
  done
  printf '%s' "$joined"
}

extra_conf_args=()

substituters="$(collect_plugin_list EXTRA_SUBSTITUTERS | join_by_space)"
if [ -n "$substituters" ]; then
  extra_conf_args+=(--extra-conf "extra-substituters = $substituters")
fi

trusted_keys="$(collect_plugin_list EXTRA_TRUSTED_PUBLIC_KEYS | join_by_space)"
if [ -n "$trusted_keys" ]; then
  extra_conf_args+=(--extra-conf "extra-trusted-public-keys = $trusted_keys")
fi

while IFS= read -r conf_line; do
  [ -n "$conf_line" ] && extra_conf_args+=(--extra-conf "$conf_line")
done < <(collect_plugin_list EXTRA_CONF)

echo "Installing Determinate Nix for $OSTYPE"
if [ -n "${extra_conf_args[*]+set}" ]; then
  printf 'Applying nix.conf lines:\n'
  printf '  %s\n' "${extra_conf_args[@]}" | grep -v -- '--extra-conf' || true
fi

curl --proto '=https' --tlsv1.2 -sSf -L "https://install.determinate.systems/nix?ci=buildkite" | \
    sh -s -- install linux \
      --no-confirm \
      --init none \
      ${extra_conf_args[@]+"${extra_conf_args[@]}"}

nohup /usr/local/bin/determinate-nixd daemon > /dev/null 2>&1 &
export NIX_REMOTE=daemon

echo "Wait for Determinate Nixd status"
while ! determinate-nixd status >/dev/null; do
    sleep 0.1
done
echo "The Nix daemon is ready!"

export PATH="/nix/var/nix/profiles/default/bin:$HOME/.nix-profile/bin:$PATH"
